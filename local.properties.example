# Copy this file to `local.properties` (same folder) and fill in your values.
# `local.properties` is git-ignored — secrets never go into source control.
#
# Android SDK location (Android Studio normally generates this automatically):
# sdk.dir=/Users/you/Library/Android/sdk

# --- Mio AI cloud brain (OpenAI-compatible Chat Completions) ---
# Any OpenAI-compatible endpoint works (OpenAI, Azure OpenAI, Ollama, LM Studio,
# OpenRouter, Together, Groq...). These are non-secret build defaults — the
# Settings screen can override them at runtime.
MIO_AI_BASE_URL=https://api.openai.com/v1
MIO_AI_MODEL=gpt-4o-mini
#
# API keys are NEVER configured here. Enter your key in the app (Settings →
# AI); it is kept in encrypted on-device storage and never baked into the APK.
